{
  // bizs 工作区根 · 运行与调试启动项
  //
  // 位置说明（与 bms/.vscode 的关系）：
  //  - 本文件作用于「工作区根」（裸目录打开 /home/minjian/develop/bizs 或 D:\Develop\bizs，或工作区文件
  //    bizs.code-workspace 的「工作区（配置）」根）；`bms/.vscode/launch.json` 是同一套启动项的 bms 版本
  //    （供 bms 单根打开时用）。
  //  - **VS Code 不读取子目录的 `.vscode/`**：把 bizs 作为根打开时，`bms/.vscode/launch.json` 不会出现在
  //    调试下拉里——这正是此前「运行和调试面板为空」的原因；反之打开 bms 单根时本文件不生效。
  //  - VS Code 不支持跨根继承，两处内容须同步维护（同根 `settings.json` 的「双保险」约定）；差异仅路径前缀
  //    （此处 `bms/...`，bms 处无前缀），另：当前文件类启动项此处用 `${file}`（绝对路径），bms 处用 `${relativeFile}`。
  //  - 前端：js-debug 内置（Node / Chromium）开箱可用；浏览器**首选系统 Google Chrome**
  //    （Linux `/usr/bin/google-chrome`；Windows 见各配置的 `windows` 平台覆盖
  //    `C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe`），已实测支持 --user-data-dir
  //    与远程调试端口，可断点浏览器内代码；备用改为系统 Chromium（`chromium`）——把上面的
  //    runtimeExecutable 换掉即可。Node 类配置在 Windows 走 `pnpm.cmd`（平台覆盖）。
  //  - 后端：`debugpy`（ms-python.debugpy 已随工作区推荐安装）；服务读 `bms/backend/config.toml`
  //    的 `[server] host/port`（缺省 0.0.0.0:8000）；解释器为 `bms/backend/.venv`（Linux `bin/python`、
  //    Windows `Scripts\\python.exe`，平台覆盖）。
  //  - 运行时模块：宿主按 `bms/frontend/apps/desktop/public/modules.json` 加载**发布归档**
  //    （`http://localhost:5002/<模块名>/<版本>/remoteEntry.js`）→ 本地看完整宿主页面须先「发布:模块产物」，
  //    由 `serve-module-releases.mjs` 在 5002 托管；未起 5002 时宿主会落「模块加载失败」兜底页。
  //  - **「全套」前置依赖**：全套 = 后端单服务 + 宿主 + Chromium；但前端 `/api` 经 vite 代理到 `VITE_API_PROXY`
  //    （缺省 `http://localhost:8088` 网关），二进**并不直连**（前端经网关按 `service_key` 绕行）。本机无
  //    8088 网关时，须在 `bms/frontend/apps/desktop/.env.local` 把代理指向可达网关（本地覆盖文件不入库），
  //    否则前端起来后 `/api` 全 502。后端单服务监听 8000。
  //  - 端口自愈：dev 类后台任务经 `dependsOn` 前置任务 `dev:清理宿主端口（5173）` 调
  //    `python3 bms/scripts/tools/dev/清理宿主端口.py`（宿主 vite 为 `strictPort: true`；占用者为非本项目
  //    进程则中止，不误杀）；后端 8000 由 `dev:清理后端端口（8000）` 经 `preLaunchTask` 清理 ——
  //    重开「全套」不必先手动停上一次调试会话。
  "version": "0.2.0",
  "configurations": [
    // ── 前端 ────────────────────────────────────────────────────────────────
    {
      // 调试 Vite dev server 本体（vite.config / 插件断点）；不调试浏览器内代码
      "name": "前端：宿主 dev（Node · Vite）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "windows": { "runtimeExecutable": "pnpm.cmd" },
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/bms/frontend/apps/desktop",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      // 宿主页面断点：先经前置任务拉起 dev（5173），再启动 Chromium 打开宿主
      "name": "前端：宿主 + Chromium（浏览器断点）",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "/usr/bin/google-chrome",
      "windows": { "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" },
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/bms/frontend/apps/desktop/src",
      "preLaunchTask": "dev:宿主（5173）",
      "sourceMaps": true
    },
    {
      // 含运行时模块的完整宿主：前置任务会确保 5002 发布存储服务在跑再起宿主 dev
      "name": "前端：宿主 + 模块 + Chromium（浏览器断点）",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "/usr/bin/google-chrome",
      "windows": { "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" },
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/bms/frontend/apps/desktop/src",
      "preLaunchTask": "dev:宿主 + 模块产物（5002 + 5173）",
      "sourceMaps": true
    },
    {
      // 开发态核对页断点（选页）：核对页不加载运行时模块，宿主路由被模块兜底页遮蔽时用它做页面级核验
      "name": "前端：核对页 + Chromium（选页）",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "/usr/bin/google-chrome",
      "windows": { "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" },
      "url": "http://localhost:5173/${input:checkPage}",
      "webRoot": "${workspaceFolder}/bms/frontend/apps/desktop/src",
      "preLaunchTask": "dev:宿主（5173）",
      "sourceMaps": true
    },
    {
      // 调试当前打开的用例文件（在编辑器里打开 bms/frontend/apps/desktop/tests/xxx.spec.ts 后 F5）
      "name": "前端：当前文件单测（Node · Vitest）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "windows": { "runtimeExecutable": "pnpm.cmd" },
      "runtimeArgs": ["exec", "vitest", "run", "${file}"],
      "cwd": "${workspaceFolder}/bms/frontend/apps/desktop",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    },
    // ── 运行时模块（自身独立开发；宿主联调走 5002 发布归档，见文件头说明）──────
    {
      "name": "模块：demo 独立开发（5002 · Node）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "windows": { "runtimeExecutable": "pnpm.cmd" },
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/bms/frontend/modules/demo",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "模块：sample 独立开发（5003 · Node）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "windows": { "runtimeExecutable": "pnpm.cmd" },
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/bms/frontend/modules/sample",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    // ── 后端（debugpy）──────────────────────────────────────────────────────
    {
      "name": "后端：单服务（debugpy · 选服务）",
      "type": "debugpy",
      "request": "launch",
      "module": "${input:backendService}",
      "cwd": "${workspaceFolder}/bms/backend",
      "python": "${workspaceFolder}/bms/backend/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/bms/backend/.venv/Scripts/python.exe" },
      "preLaunchTask": "dev:清理后端端口（8000）",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // 固定后端服务（默认 bms_identity）：专供「全套」使用 ——「选服务」用的 pickString 不记忆上次
      // 选择、每次启动都要手选一次；换服务时用上面的「选服务」项，或直接改这里的 module。
      "name": "后端：单服务（debugpy · bms_identity）",
      "type": "debugpy",
      "request": "launch",
      "module": "bms_identity",
      "cwd": "${workspaceFolder}/bms/backend",
      "python": "${workspaceFolder}/bms/backend/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/bms/backend/.venv/Scripts/python.exe" },
      "preLaunchTask": "dev:清理后端端口（8000）",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // 调试当前打开的后端用例（在编辑器里打开 bms/backend/**/tests/test_*.py 后 F5）
      "name": "后端：当前文件单测（debugpy · pytest）",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "cwd": "${workspaceFolder}/bms/backend",
      "python": "${workspaceFolder}/bms/backend/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/bms/backend/.venv/Scripts/python.exe" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // 「全套」的后端成员（本地开发主形态）：由 `python3 bms/scripts/tools/dev/本地全套.py up` 起**三个**服务
      // （按各仓 deploy/local_stack.toml 装载：缺省 tenant/platform/identity/mdm；同一 8000 + loopback 别名，与服务基址模板 http://{service}:8000 同形，
      // 并加载 `bms/backend/.dev-keys.local` 的开发密钥；`org` 已归 mdm 产品服务）。服务是后台进程——本终端
      // 只承载会话，关掉不影响服务；停服务请用任务 `dev:后端本地全套·停`。
      "name": "后端：本地全套（脚本）",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/bms/scripts/tools/dev/本地全套.py\" up",
      "cwd": "${workspaceFolder}/bms"
    },
    {
      // **后端断点**用本项（「后端：本地全套（脚本）」是脚本起的后台进程，不带调试器）。
      // 步骤：① 脚本起的三个服务里先腾出要调试的那个：
      //   `python3 bms/scripts/tools/dev/本地全套.py stop identity`（或任务「dev:后端本地全套·停」后
      //   用任务 up 只起其余——`本地全套.py up --services "tenant platform"`）；
      // ② 启动本项（选服务）→ 由 `bms/backend/ops/dev_run.py` 注入 loopback 别名（127.0.0.2/4/5）+ 同一 8000 端口
      //   + `bms/backend/.dev-keys.local` 开发密钥 + Redis，再 runpy 进服务入口 ⇒ 断点 / 变量 / 调用栈与
      //   `python -m bms_<服务>` 一致（`justMyCode: false`：可步入框架与基座代码）；
      // ③ 调试会话停止即服务结束，之后 `本地全套.py up` 一键补回。
      "name": "后端：单服务（debugpy · 平台三服务）",
      "type": "debugpy",
      "request": "launch",
      "module": "ops.dev_run",
      "args": ["--service", "${input:backendService}"],
      "cwd": "${workspaceFolder}/bms/backend",
      "python": "${workspaceFolder}/bms/backend/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/bms/backend/.venv/Scripts/python.exe" },
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // **产品进程断点**（mdm 等）：产品服务的代码在**产品仓**，bms 侧 `ops/dev_run.py` 无法跨仓 runpy
      // 进去，故用 IDE 原生 `module` 启动 + `envFile`——环境（回环别名 / 同一 8000 / 端点覆盖 / 开发密钥）
      // 由 `本地全套.py up`（收尾自动）或 `env` 子命令写到 `<产品仓>/deploy/.dev-env.<服务键>.local`，
      // 与脚本起的进程完全同源 ⇒ 断点 / 变量 / 调用栈与 `python -m mdm` 一致（`justMyCode: false` 可步入基座）。
      // 步骤：① `python3 bms/scripts/tools/dev/本地全套.py stop mdm` 腾位；② 启动本项；
      // ③ 调试会话停止即服务结束，之后 `本地全套.py up` 一键补回。
      // 新增产品仓 = 复制本项，按该仓声明改 module / cwd / python / envFile 四处（服务键同名）。
      "name": "后端：产品服务（debugpy · mdm）",
      "type": "debugpy",
      "request": "launch",
      "module": "mdm",
      "cwd": "${workspaceFolder}/mdm/backend",
      "python": "${workspaceFolder}/mdm/backend/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/mdm/backend/.venv/Scripts/python.exe" },
      "envFile": "${workspaceFolder}/mdm/deploy/.dev-env.mdm.local",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      // 旧口径（单后端服务）：后端**只起 identity 一个**，且不加载 `.dev-keys.local`、不绑 loopback 别名
      // → 平台三服务形态下不足以登录（服务间 http://platform:8000 亦不通）。本地开发请用下面的「本机全套」项；
      // 本项保留用于「只调 identity 单服务」的场景。
      "name": "全套：后端单服务 + 宿主 + Chromium",
      "configurations": ["后端：单服务（debugpy · bms_identity）", "前端：宿主 + 模块 + Chromium（浏览器断点）"]
    },
    {
      // 一键：全套服务（脚本，后台进程）+ 宿主 + 模块产物 + Chromium。**前端断点可直接用**（Chromium 调试会话）；
      // **后端断点**请改用「后端：单服务（debugpy · 平台三服务）」单项（先 `本地全套.py stop <服务>` 腾位）。
      "name": "全套（本机全套 + 宿主 + Chromium）",
      "configurations": ["后端：本地全套（脚本）", "前端：宿主 + 模块 + Chromium（浏览器断点）"]
    }
  ],
  "inputs": [
    {
      "id": "checkPage",
      "type": "pickString",
      "description": "选择要调试的开发态核对页（其余核对页把文件名填进 url 即可）",
      "default": "login-check.html",
      "options": [
        "login-check.html",
        "auth-guard-check.html",
        "captcha-check.html",
        "wizard-preference-check.html",
        "bulk-theme-tenant-check.html",
        "permission-config-check.html",
        "icon-code-check.html",
        "org-check.html",
        "file-check.html",
        "search-check.html",
        "notice-check.html",
        "chart-check.html",
        "data-display-check.html",
        "container-check.html",
        "display-feedback-check.html",
        "field-check.html",
        "input-check.html",
        "layout-check.html",
        "menu-check.html",
        "role-check.html",
        "dict-record-check.html"
      ]
    },
    {
      "id": "backendService",
      "type": "pickString",
      "description": "选择后端服务模块（对应 bms/backend/services/<域>）",
      "default": "bms_identity",
      "options": [
        "bms_identity",
        "bms_platform",
        "bms_tenant",
        "bms_file",
        "bms_notification",
        "bms_search",
        "bms_ai",
        "bms_report"
      ]
    }
  ]
}
