{
  // bizs 工作区根 · 运行与调试启动项
  //
  // 位置说明（与 bms/.vscode 的关系）：
  //  - 本文件作用于「工作区根」（裸目录打开 /home/minjian/develop/bizs，或工作区文件 bizs.code-workspace
  //    的「工作区（配置）」根）；`bms/.vscode/launch.json` 是同一套启动项的 bms 版本（供 bms 单根打开时用）。
  //  - **VS Code 不读取子目录的 `.vscode/`**：把 bizs 作为根打开时，`bms/.vscode/launch.json` 不会出现在
  //    调试下拉里——这正是此前「运行和调试面板为空」的原因；反之打开 bms 单根时本文件不生效。
  //  - VS Code 不支持跨根继承，两处内容须同步维护（同根 `settings.json` 的「双保险」约定）；差异仅路径前缀
  //    （此处 `bms/...`，bms 处无前缀），另：当前文件类启动项此处用 `${file}`（绝对路径），bms 处用 `${relativeFile}`。
  //  - 前端：js-debug 内置（Node / Chrome）开箱可用；浏览器**首选系统 Google Chrome**（`google-chrome`，
  //    本机 154.x，已实测支持 --user-data-dir 与远程调试端口）；**备用**改 `chromium`（/snap/bin/chromium）。
  //  - 后端：`debugpy`（ms-python.debugpy 已装）；服务读 `bms/backend/config.toml` 的 `[server] host/port`（缺省 0.0.0.0:8000）。
  //  - 运行时模块：宿主按 `bms/frontend/apps/desktop/public/modules.json` 加载**发布归档**
  //    （`http://localhost:5002/<模块名>/<版本>/remoteEntry.js`）→ 本地看完整宿主页面须先「发布:模块产物」，
  //    由 `serve-module-releases.mjs` 在 5002 托管；未起 5002 时宿主会落「模块加载失败」兜底页。
  //  - **「全套」前置依赖**：全套 = 后端单服务 + 宿主 + Chrome；但前端 `/api` 经 vite 代理到 `VITE_API_PROXY`
  //    （缺省 `http://localhost:8088` 网关），二进**并不直连**（前端经网关按 `service_key` 绕行）。本机无
  //    8088 网关时，须在 `bms/frontend/apps/desktop/.env.local` 把代理指向可达网关（本地覆盖文件不入库），
  //    否则前端起来后 `/api` 全 502。后端单服务监听 8000。
  //  - 端口自愈：dev 任务在 command 开头**内联**调用 `bms/scripts/tools/dev/清理宿主端口.sh` 清理 5173
  //    （宿主 vite 为 `strictPort: true`；非本项目占用则中止）；后端 8000 由 `dev:清理后端端口（8000）`
  //    经 `preLaunchTask` 清理 —— 重开「全套」不必先手动停上一次调试会话。
  "version": "0.2.0",
  "configurations": [
    // ── 前端 ────────────────────────────────────────────────────────────────
    {
      "name": "前端：宿主 dev（Node · Vite）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/bms/frontend/apps/desktop",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "前端：宿主 + Chrome（浏览器断点）",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "/usr/bin/google-chrome",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/bms/frontend/apps/desktop/src",
      "preLaunchTask": "dev:宿主（5173）",
      "sourceMaps": true
    },
    {
      "name": "前端：宿主 + 模块 + Chrome（浏览器断点）",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "/usr/bin/google-chrome",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/bms/frontend/apps/desktop/src",
      "preLaunchTask": "dev:宿主 + 模块产物（5002 + 5173）",
      "sourceMaps": true
    },
    {
      "name": "前端：核对页 + Chrome（选页）",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "/usr/bin/google-chrome",
      "url": "http://localhost:5173/${input:checkPage}",
      "webRoot": "${workspaceFolder}/bms/frontend/apps/desktop/src",
      "preLaunchTask": "dev:宿主（5173）",
      "sourceMaps": true
    },
    {
      // 调试当前打开的用例文件（在编辑器里打开 bms/frontend/apps/desktop/tests/xxx.spec.ts 后 F5）
      "name": "前端：当前文件单测（Node · Vitest）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vitest", "run", "${file}"],
      "cwd": "${workspaceFolder}/bms/frontend/apps/desktop",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    },
    // ── 运行时模块（自身独立开发；宿主联调走 5002 发布归档）──────────────────
    {
      "name": "模块：demo 独立开发（5002 · Node）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/bms/frontend/modules/demo",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "模块：sample 独立开发（5003 · Node）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/bms/frontend/modules/sample",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    // ── 后端（debugpy）──────────────────────────────────────────────────────
    {
      "name": "后端：单服务（debugpy · 选服务）",
      "type": "debugpy",
      "request": "launch",
      "module": "${input:backendService}",
      "cwd": "${workspaceFolder}/bms/backend",
      "python": "${workspaceFolder}/bms/backend/.venv/bin/python",
      "preLaunchTask": "dev:清理后端端口（8000）",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // 固定后端服务（默认 bms_identity）：专供「全套」使用 ——「选服务」用的 pickString 不记忆上次
      // 选择、每次启动都要手选一次；换服务时用上面的「选服务」项，或直接改这里的 module。
      "name": "后端：单服务（debugpy · bms_identity）",
      "type": "debugpy",
      "request": "launch",
      "module": "bms_identity",
      "cwd": "${workspaceFolder}/bms/backend",
      "python": "${workspaceFolder}/bms/backend/.venv/bin/python",
      "preLaunchTask": "dev:清理后端端口（8000）",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      // 调试当前打开的后端用例（在编辑器里打开 bms/backend/**/tests/test_*.py 后 F5）
      "name": "后端：当前文件单测（debugpy · pytest）",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "cwd": "${workspaceFolder}/bms/backend",
      "python": "${workspaceFolder}/bms/backend/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // 「全套」的后端成员（本地开发主形态）：由 `bms/scripts/tools/dev/本地全套.sh up` 起**四个**服务
      // （tenant/org/platform/identity；同一 8000 + loopback 别名，与服务基址模板 http://{service}:8000 同形，
      // 并加载 `bms/backend/.dev-keys.local` 的开发密钥）。服务是 nohup 后台进程——本终端只承载会话，
      // 关掉不影响服务；停服务请用任务 `dev:后端本地全套·停（四服务）`。
      "name": "后端：本地全套（四服务 · 脚本）",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash \"${workspaceFolder}/bms/scripts/tools/dev/本地全套.sh\" up && exec bash -i",
      "cwd": "${workspaceFolder}/bms"
    },
    {
      // **后端断点**用本项（「后端：本地全套（四服务 · 脚本）」是脚本起的后台进程，不带调试器）。
      // 步骤：① `bash bms/scripts/tools/dev/本地全套.sh stop identity` 先腾出要调试的服务；
      // ② 启动本项（选服务）——由 `bms/backend/ops/dev_run.py` 注入 loopback 别名（127.0.0.2~5）
      //   + 同一 8000 端口 + `bms/backend/.dev-keys.local` 密钥 + Redis，再 runpy 进服务入口 ⇒
      //   断点 / 变量 / 调用栈与 `python -m bms_<服务>` 一致（`justMyCode: false`：可步入框架与基座）；
      // ③ 调试会话停止即服务结束，之后 `本地全套.sh up` 一键补回。
      "name": "后端：单服务（debugpy · 本机四服务）",
      "type": "debugpy",
      "request": "launch",
      "module": "ops.dev_run",
      "args": ["--service", "${input:backendService}"],
      "cwd": "${workspaceFolder}/bms/backend",
      "python": "${workspaceFolder}/bms/backend/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    }
  ],
  "compounds": [
    {
      // 旧口径（单后端服务）：后端**只起 bms_identity 一个**，且不加载 `.dev-keys.local`、不绑 loopback 别名
      // → 本机四服务形态下不足以登录（其 preLaunchTask `清理后端端口（8000）` 还会把四服务一起清掉）。
      // 本地开发请用下面的「本地四服务」项；本项保留用于「只调 identity 单服务」的场景。
      "name": "全套：后端单服务 + 宿主 + Chrome",
      "configurations": ["后端：单服务（debugpy · bms_identity）", "前端：宿主 + 模块 + Chrome（浏览器断点）"]
    },
    {
      // 一键：四服务（脚本，后台进程）+ 宿主 + 模块产物 + Chrome。**前端断点可直接用**（Chrome 调试会话）；
      // **后端断点**请改用「后端：单服务（debugpy · 本机四服务）」单项（先 `本地全套.sh stop <服务>` 腾位）。
      "name": "全套（本地四服务 + 宿主 + Chrome）",
      "configurations": ["后端：本地全套（四服务 · 脚本）", "前端：宿主 + 模块 + Chrome（浏览器断点）"]
    }
  ],
  "inputs": [
    {
      "id": "checkPage",
      "type": "pickString",
      "description": "选择要调试的开发态核对页（其余核对页把文件名填进 url 即可）",
      "default": "login-check.html",
      "options": [
        "login-check.html",
        "auth-guard-check.html",
        "captcha-check.html",
        "wizard-preference-check.html",
        "bulk-theme-tenant-check.html",
        "permission-config-check.html",
        "org-check.html",
        "file-check.html",
        "search-check.html",
        "notice-check.html",
        "chart-check.html",
        "data-display-check.html",
        "layout-check.html",
        "menu-check.html"
      ]
    },
    {
      "id": "backendService",
      "type": "pickString",
      "description": "选择后端服务模块（对应 bms/backend/services/<域>）",
      "default": "bms_identity",
      "options": [
        "bms_identity",
        "bms_platform",
        "bms_tenant",
        "bms_org",
        "bms_file",
        "bms_notification",
        "bms_search",
        "bms_ai",
        "bms_report"
      ]
    }
  ]
}
