{
  // biz/bms文档 为产品仓库根的基座软链（→ bms/bms文档），内容随 bms 仓库展示，此处隐藏避免重复
  "files.exclude": {
    "biz/bms文档": true,
    "**/node_modules": true,
    "**/.venv": true
  },
  // 检索：工作区根 .gitignore 为「全忽略 + 白名单」（bms/ biz/ test/ 均在忽略内），须关掉 ignore 文件过滤，
  // 否则在根目录打开（或在工作区根「工作区（配置）」这一根的搜索范围内）搜不到 bms/ 下任何代码与文档。
  // 噪音改由 search.exclude 显式排除（依赖已物理外置为符号链接，仍显式屏蔽）。
  // 与 bizs.code-workspace 的 settings 保持一致（双保险：裸目录打开 / 工作区文件打开均生效）。
  "search.useIgnoreFiles": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.git": true,
    "**/dist": true
  },
  // Python 后端：解释器与分析根（双保险——裸目录打开时 `bms/.vscode/settings.json` 不生效，
  // 故此处按 `bms/` 前缀再声明一份）。
  // 解释器一律写 `bin/python`（Linux 原生布局，跨平台一份配置）：Windows 上由依赖工具链
  // `bms/scripts/tools/deps/外置依赖.py` 在 venv 内补 `bin/python` 兼容入口（→ Scripts/python.exe），
  // 因此本路径在双平台都成立，**不要**改成 Scripts/python.exe（会让 Linux 开发机失效）。
  "python.defaultInterpreterPath": "bms/backend/.venv/bin/python",
  "python.analysis.extraPaths": [
    "bms/backend",
    "bms/backend/libs/bms_core/src",
    "bms/backend/services/txn/src",
    "bms/backend/services/platform/src",
    "bms/backend/services/identity/src",
    "bms/backend/services/tenant/src",
    "bms/backend/services/file/src",
    "bms/backend/services/notification/src",
    "bms/backend/services/search/src",
    "bms/backend/services/ai/src",
    "bms/backend/services/report/src"
  ],
  // Python 环境发现范围：钉到后端 venv，避免 `*/.venv` 默认规则命中 `tmp/.venv`
  //（那是 tmp/ 临时脚本用的 paramiko 环境，被误选会让 Ruff / Pylance 用错解释器）。
  "python-envs.workspaceSearchPaths": ["bms/backend/.venv"],
  // Python 类型检查：与项目门禁同口径（bms/backend/pyproject.toml 的 [tool.pyright]）。
  // 本项目实际装的是 Pylance（未装 basedpyright），故按 Pylance 认的 `python.analysis.*` 写；
  // 严格档 + 排除 alembic 迁移（项目 `include` 只含 libs/services）与 tmp/、mdm/ 等非本仓 Python。
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "bms/backend/alembic",
    "tmp",
    "mdm",
    "biz",
    "test"
  ],
  "python.analysis.ignore": ["bms/backend/alembic", "**/alembic/**"],
  // ESLint（flat config）：monorepo 下**每个包各一份** `eslint.config.js`（`bms/frontend/{apps,packages,modules}/*`），
  // 必须让扩展「按被检查文件就近取配置」——否则它会把 `apps/desktop` 的配置套到 `modules/*` 的文件上，
  // 解析器随即报「No tsconfigRootDir was set, and multiple candidate TSConfigRootDirs are present」。
  // 双保险：各包 `eslint.config.js` 亦已把 `parserOptions.tsconfigRootDir` 锚到自身目录。
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.validate": ["javascript", "typescript", "vue"]
}
