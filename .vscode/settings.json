{
  // biz/bms文档 为产品仓库根的基座软链（→ bms/bms文档），内容随 bms 仓库展示，此处隐藏避免重复
  "files.exclude": {
    "biz/bms文档": true,
    "**/node_modules": true,
    "**/.venv": true
  },
  // 检索：工作区根 .gitignore 为「全忽略 + 白名单」（bms/ biz/ test/ 均在忽略内），须关掉 ignore 文件过滤，
  // 否则在根目录打开（或在工作区根「工作区（配置）」这一根的搜索范围内）搜不到 bms/ 下任何代码与文档。
  // 噪音改由 search.exclude 显式排除（依赖已物理外置为符号链接，仍显式屏蔽）。
  // 与 bizs.code-workspace 的 settings 保持一致（双保险：裸目录打开 / 工作区文件打开均生效）。
  "search.useIgnoreFiles": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.git": true,
    "**/dist": true
  },
  // Python 后端：解释器与分析根（双保险——裸目录打开时 `bms/.vscode/settings.json` 不生效，
  // 故此处按 `bms/` 前缀再声明一份；缺失会导致 basedpyright/Pylance 回落系统 Python，
  // 满屏「无法解析导入 sqlalchemy」类报错）。
  "python.defaultInterpreterPath": "bms/backend/.venv/bin/python",
  "python.analysis.extraPaths": ["bms/backend"],
  // Python 类型检查：与项目门禁同口径 —— `basedpyright` 默认 `recommended` 档会把项目
  // **本就不检查**的 `alembic/versions/**`（项目 `[tool.pyright] include` 只含 libs/services）
  // 报成一片风格问题；此处指向项目 pyproject.toml，并忽略 alembic 迁移脚本。
  "basedpyright.analysis.configFilePath": "bms/backend/pyproject.toml",
  // alembic 迁移不在项目 `[tool.pyright] include`（只含 libs/services）内，但 basedpyright 会分析
  // 「打开的文件」，故用 ignore（抑制诊断）+ exclude 双保险；路径给足多种形式，避免基准差异未命中。
  "basedpyright.analysis.ignore": [
    "alembic",
    "bms/backend/alembic",
    "**/alembic/**"
  ],
  "basedpyright.analysis.exclude": ["alembic", "bms/backend/alembic", "**/alembic/**"],
  // ESLint（flat config）：monorepo 下**每个包各一份** `eslint.config.js`（`bms/frontend/{apps,packages,modules}/*`），
  // 必须让扩展「按被检查文件就近取配置」——否则它会把 `apps/desktop` 的配置套到 `modules/*` 的文件上，
  // 解析器随即报「No tsconfigRootDir was set, and multiple candidate TSConfigRootDirs are present」。
  // 双保险：各包 `eslint.config.js` 亦已把 `parserOptions.tsconfigRootDir` 锚到自身目录。
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.validate": ["javascript", "typescript", "vue"]
}
