{
  // bizs 工作区根 · 任务（供「运行任务」与 launch.json 的 preLaunchTask 使用）
  //
  // 位置说明（与 bms/.vscode 的关系）：
  //  - 本文件作用于「工作区根」（裸目录打开 /home/minjian/develop/bizs，或工作区文件 bizs.code-workspace
  //    的「工作区（配置）」根）；`bms/.vscode/tasks.json` 是同一套任务的 bms 版本（供 bms 单根打开时用）。
  //  - VS Code 不支持跨根继承配置，故两处内容必须同步维护（与根 `settings.json` 的「双保险」约定同口径）：
  //    两处差异仅在于路径前缀（此处为 `bms/...`，bms 处为无前缀）。
  //  - 一律用 shell + 显式 `pnpm` / `node` / `python3` / `uv`（不依赖 IDE 的 npm 任务探测，避免落到 npm）；
  //  - dev / 服务类任务为**后台任务**：以日志关键字为就绪信号（`preLaunchTask` 需据此判断可继续）；
  //    「问题匹配器」正则刻意不匹配任何行，避免把日志灌进「问题」面板。
  //  - **端口自愈与前置准备**：`vite.config.ts` 为 `strictPort: true`（端口被占即启动失败），故 dev 类
  //    后台任务把准备动作拆成 `dependsOn` 前置任务（`dev:清理宿主端口（5173）` 调
  //    `bms/scripts/tools/dev/清理宿主端口.sh`；`dev:确保模块产物服务（5002）` 幂等拉起 5002），自身
  //    命令只留 `pnpm dev`——**准备动作不要写进 background 任务的 command**，其耗时会算进就绪等待窗口，
  //    触发「任务尚未退出，并且未定义 problemMatcher」提示（此时点「仍要调试」可继续跑）。
  //    脚本按进程 cwd 判定归属，非本项目占用则中止。前端 /api 代理口径见 apps/desktop/.env.local。
  //  - **background 就绪正则必须容忍 ANSI 颜色码**：vite 在 TTY 下输出的 `Local:` 实为
  //    `Local` + `ESC[22m` + `:`（字面 `Local:` 不存在），故 `endsPattern` 必须写 `Local.*https?://`；
  //    否则 `activeOnStart` 之后再无就绪信号 → `preLaunchTask` 弹「正在等待 preLaunchTask」，
  //    而 dev server 其实已经跑起来了。
  //  - **后端 8000 自愈**：`dev:清理后端端口（8000）`（普通任务，非 background）供 `后端：单服务（debugpy ·
  //    选服务）` 的 `preLaunchTask` 复用——重开「全套」不必先手动停上一次调试会话（否则 Address already in use）。
  "version": "2.0.0",
  "tasks": [
    {
      // 供 dev 类后台任务作 dependsOn 前置：清理本项目占 5173 的旧宿主 dev（含等待端口释放），
      // 占用者为非本项目进程时退出非 0（不误杀）。**准备动作不放进 background 任务的命令里**，
      // 否则其耗时会计入 background 的就绪等待窗口，触发「尚未退出，并且未定义 problemMatcher」提示。
      "label": "dev:清理宿主端口（5173）",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/bms/scripts/tools/dev/清理宿主端口.sh\" 5173 \"${workspaceFolder}/bms/frontend/apps/desktop\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // 供「宿主 + 模块」作 dependsOn 前置：确保 5002 发布存储服务在跑（缺则后台拉起，幂等）
      "label": "dev:确保模块产物服务（5002）",
      "type": "shell",
      "command": "pgrep -f 'serve-module-releases.mjs' >/dev/null || (nohup node \"${workspaceFolder}/bms/frontend/scripts/serve-module-releases.mjs\" > /tmp/bms-serve-releases.log 2>&1 &); sleep 1",
      "options": { "cwd": "${workspaceFolder}/bms" },
      "problemMatcher": []
    },
    {
      // 端口自愈与 5002 由前置任务负责；本任务只跑 vite —— background 就绪检测面对纯 vite 输出
      "label": "dev:宿主（5173）",
      "detail": "BMS 宿主 PC 管理端 Vite 开发服务器（前置任务清理本项目旧宿主 dev；/api 代理经 VITE_API_PROXY 可配：缺省 http://localhost:8088 网关，本机无网关时经 apps/desktop/.env.local 指向可达网关）",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/bms/frontend/apps/desktop" },
      "dependsOn": "dev:清理宿主端口（5173）",
      "dependsOrder": "sequence",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "bizs-vite-desktop",
        "pattern": [{ "regexp": "^\\[bizs-vite\\]\\s(.*)$", "file": 1, "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local.*https?://"
        }
      }
    },
    {
      "label": "dev:宿主 + 模块产物（5002 + 5173）",
      "detail": "宿主加载运行时模块的前置组合：先经 dependsOn 清理 5173 并确保 5002 在跑，再起宿主 dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/bms/frontend/apps/desktop" },
      "dependsOn": ["dev:清理宿主端口（5173）", "dev:确保模块产物服务（5002）"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "bizs-vite-desktop-with-modules",
        "pattern": [{ "regexp": "^\\[bizs-vite\\]\\s(.*)$", "file": 1, "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local.*https?://"
        }
      }
    },
    {
      "label": "服务:模块产物（5002 · CORS 静态）",
      "detail": "托管 bms/frontend/releases/**（URL 即 /<模块名>/<版本>/remoteEntry.js，与清单同构，带 CORS）",
      "type": "shell",
      "command": "node frontend/scripts/serve-module-releases.mjs",
      "options": { "cwd": "${workspaceFolder}/bms" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "bizs-module-releases",
        "pattern": [{ "regexp": "^\\[bizs-mreleases\\]\\s(.*)$", "file": 1, "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "module-releases",
          "endsPattern": "模块入口形如"
        }
      }
    },
    {
      "label": "发布:模块产物（demo + sample · 构建 + 发布）",
      "detail": "构建并发布两个运行时模块到 bms/frontend/releases/（归档不入库；同版本重发用 --force）",
      "type": "shell",
      "command": "pnpm --filter @bms/module-demo run build && pnpm --filter @bms/module-sample run build && node frontend/scripts/release-module.mjs publish --module demo --force && node frontend/scripts/release-module.mjs publish --module sample --force",
      "options": { "cwd": "${workspaceFolder}/bms" },
      "problemMatcher": []
    },
    {
      "label": "dev:模块 demo 独立开发（5002）",
      "detail": "demo 模块自身 Vite dev（与「服务:模块产物（5002）」互斥——两者都占 5002，且 dev 只服务 /remoteEntry.js）",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/bms/frontend/modules/demo" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "bizs-vite-module-demo",
        "pattern": [{ "regexp": "^\\[bizs-vite\\]\\s(.*)$", "file": 1, "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local.*https?://"
        }
      }
    },
    {
      "label": "dev:模块 sample 独立开发（5003）",
      "detail": "sample 模块自身 Vite dev（独立开发用；宿主加载的是 5002 上的发布归档，不是本服务）",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/bms/frontend/modules/sample" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "bizs-vite-module-sample",
        "pattern": [{ "regexp": "^\\[bizs-vite\\]\\s(.*)$", "file": 1, "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local.*https?://"
        }
      }
    },
    {
      // 供 `后端：单服务（debugpy · 选服务）` 的 preLaunchTask 复用：普通任务（非 background），
      // VS Code 会等它正常结束再拉起调试器，不会出现就绪等待问题。
      "label": "dev:清理后端端口（8000）",
      "detail": "清理占用 8000 的本项目旧后端调试进程（仅限 cwd 为 bms/backend 者；非本项目占用则中止，不误杀）",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/bms/scripts/tools/dev/清理宿主端口.sh\" 8000 \"${workspaceFolder}/bms/backend\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "检查：前端基座三包（lint + typecheck + 用例）",
      "detail": "core / api-types / vue / ui-ep 四包检查（bms 根：pnpm run check）",
      "type": "shell",
      "command": "pnpm run check",
      "options": { "cwd": "${workspaceFolder}/bms" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "检查：前端宿主（lint + vue-tsc + 用例 + 体积预算）",
      "detail": "bms/frontend/apps/desktop：ESLint + vue-tsc -b + Vitest + 构建体积预算",
      "type": "shell",
      "command": "pnpm run lint && pnpm exec vue-tsc -b && pnpm run test && pnpm run build && pnpm run budget",
      "options": { "cwd": "${workspaceFolder}/bms/frontend/apps/desktop" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "检查：文档基座（断链 / 越界 / 阶段状态）",
      "detail": "check-links + check-docs-scope + check-status --stage 06_认证与安全 --strict",
      "type": "shell",
      "command": "python3 scripts/tools/base-check/check-links.py && python3 scripts/tools/base-check/check-docs-scope.py && python3 scripts/tools/check-docs/check-status.py --stage 06_认证与安全 --strict",
      "options": { "cwd": "${workspaceFolder}/bms" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "检查：后端（ruff + 格式 + pyright）",
      "detail": "bms/backend：uv run ruff check / ruff format --check / pyright（本地 pyright 依赖外置时可能不可用，CI 兜底）",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format --check . && uv run pyright",
      "options": { "cwd": "${workspaceFolder}/bms/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
