{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen3.8-27b-ud-q4-k-m",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "本地多模态（LM Studio）",
