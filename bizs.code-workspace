{
  "folders": [
    { "path": ".", "name": "工作区（配置）" },
    { "path": "bms", "name": "BMS 基座/平台" },
    { "path": "biz", "name": "biz 产品" },
    { "path": "mdm", "name": "mdm 主数据" },
    { "path": "test", "name": "测试资产" }
  ],
  "settings": {
    // 说明：search.exclude 会继承 files.exclude 的全局模式，故不得再用 files.exclude 隐藏 bms/biz/test
    //（隐藏即等于「从搜索框搜不到」）；同时工作区根 .gitignore 为「全忽略 + 白名单」，需关掉 ignore 文件过滤，
    // 否则在工作区根这一根下搜索会跳过整个 bms/（含全部代码与文档）。
    // 代价：Explorer 中 bms/biz/test 会同时以「独立根」与「工作区根下的子目录」两种形态出现。
    //
    // 注意：**Python 相关设置不要写在本文件**——本文件是 workspace 级，会被 biz / mdm / test 三个根一并继承，
    // 而 `python.defaultInterpreterPath` 是相对各根解析的，在这些根下会指向不存在的路径并弹
    //「无法解析默认解释器路径」。Python 设置改由各根自己的 `.vscode/settings.json` 声明（folder 级）：
    // 工作区根写 `bms/backend/.venv/bin/python`、BMS 根写 `backend/.venv/bin/python`（双保险）。
    "search.useIgnoreFiles": false,
    "files.exclude": {
      "**/node_modules": true,
      "**/.venv": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/.pytest_cache": true,
      "**/.git": true,
      "**/dist": true
    }
  }
}
