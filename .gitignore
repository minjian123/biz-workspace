# 工作区 git 仓库：只跟踪工作区配置文件，其余全部忽略
# bms/ 与各产品仓库目录由各自的 git 管理
/*
# 本地数据库目录（各仓库统一放 database/<仓库>/；本地运行产物，不入库）
database/
# 项目临时目录（临时文件 / 截图 / 脚本草稿等；即使调整上方白名单也始终不入库）
# 落点红线见 AGENTS.md「工作区卫生」节：日志 / 临时文件只许落本目录，护栏由
# scripts/tools/workspace/check_workspace_hygiene.py 执行（已接入 bms 预检第一步）。
tmp/
!/.gitignore
# 检索可见性规则（rg 类工具读取，不影响 git 跟踪本身）
# 必须入 git：本文件首行 /* 是白名单，管「工作区仓能提交什么」；rg 类工具默认
# 把它当可见性规则读，会把白名单读成「这下面都不要」，故需 .ignore 的反消除
# 规则恢复 agent 在【工作区根】的检索可见性（两者分工，不是重复）。
# 详见 AGENTS.md「代码与文档检索」节。
!/.ignore
!/.opencode/
!/.vscode/
!/AGENTS.md
!/README.md
!/LICENSE
!/.gitattributes
# 行尾口径：工作区根与各仓一致的 EditorConfig（end_of_line = lf）
!/.editorconfig
# 镜像构建上下文排除规则（2026-10-27 起产品镜像构建上下文为工作区根，见 AGENTS.md「依赖管理」节）
!/.dockerignore
!/scripts/
# Python 字节码缓存：!/scripts/ 白名单放行了整个目录，需单独排掉缓存
scripts/**/__pycache__/
*.py[cod]
!/*.code-workspace
